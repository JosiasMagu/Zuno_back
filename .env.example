DATABASE_URL=postgresql://UTILIZADOR:SENHA@localhost:5432/zuno_db
DATABASE_URL_TEST=postgresql://UTILIZADOR:SENHA@localhost:5432/zuno_db_test
JWT_ACCESS_SECRET="SUBSTITUI_POR_STRING_ALEATORIA_DE_PELO_MENOS_64_CHARS"

JWT_ACCESS_EXPIRES_IN="15m"

# Duracao da sessao. Cada renovacao do refresh token volta a contar daqui.
JWT_REFRESH_EXPIRES_IN="7d"

# Segundos em que o refresh token anterior ainda e aceite depois de uma
# renovacao, para a app que perdeu a resposta na rede poder repetir o pedido.
# Fora desta janela, um refresh token ja usado termina a sessao. 0 desliga.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30

# Custo do bcrypt para as passwords (4 a 15). Sem a variavel usa 12, e em
# production nao pode ser inferior a 12. Os testes E2E usam 4 para correr
# depressa.
PASSWORD_HASH_ROUNDS=12

CLOUDINARY_CLOUD_NAME="o_teu_cloud_name"
CLOUDINARY_API_KEY="a_tua_api_key"
CLOUDINARY_API_SECRET="o_teu_api_secret"

ALLOWED_ORIGINS="http://localhost:3001"

PORT=3000

# development | test | production. Com outro valor (ou sem a variavel) a
# aplicacao recusa arrancar. Em production os segredos JWT precisam de 64
# caracteres ou mais e os AUTO_APPROVE_* nao podem estar ligados.
NODE_ENV="development"

# Numero de proxies inversos a frente da API (0 = nenhum). Com 1 ou mais, o IP
# do cliente e lido de X-Forwarded-For, e e esse IP que o rate limit conta.
TRUST_PROXY_HOPS=0

# Canal dos codigos de verificacao (telefone e recuperacao de password).
# log: o codigo e escrito no log. So para desenvolvimento: em production a
# aplicacao recusa arrancar com este valor.
# silent: o codigo nao e entregue nem escrito em lado nenhum.
# Sem a variavel: log em development, silent nos outros ambientes.
NOTIFICATIONS_DRIVER="log"

LOG_LEVEL="debug"

# Token que o scraper envia em "Authorization: Bearer <token>" para ler
# /metrics. Pelo menos 32 caracteres. Obrigatório em produção; vazio em
# desenvolvimento deixa as métricas abertas.
METRICS_TOKEN=""

# Opcionais. Sentry desactivado se DSN nao for fornecido.
SENTRY_DSN=""
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0"

# Dev/staging convenience: pula a moderacao ADMIN ao criar
# equipamento/servico (status=ACTIVE em vez de PENDING_REVIEW).
# Em producao deixar desligado.
AUTO_APPROVE_EQUIPMENT="false"
AUTO_APPROVE_SERVICES="false"

# Pagamentos. PAYMENTS_PROVIDER: manual (o admin confirma pelo extracto
# M-Pesa), simulator (desenvolvimento e testes, recusado em producao) ou
# mpesa (quando o adaptador estiver pronto). Ver docs/MPESA-INTEGRACAO.md.
PAYMENTS_PROVIDER="manual"
# Segredo que o fornecedor envia nos avisos (32 caracteres ou mais).
# Obrigatorio em producao com um fornecedor automatico.
PAYMENTS_WEBHOOK_SECRET=""
# Modo manual: o numero ou codigo M-Pesa para onde o cliente paga, e o nome
# que ele ve. O numero e obrigatorio em producao no modo manual.
PAYMENTS_MANUAL_RECEIVER_NUMBER=""
PAYMENTS_MANUAL_RECEIVER_NAME=""
# Valor (MZN) ate ao qual um payout sai sozinho pelo fornecedor. Acima disso
# precisa da aprovacao de um admin.
PAYOUT_AUTO_MAX_AMOUNT="5000"
# true: quem deu um pagamento como recebido nao aprova nem executa as saidas
# dele. Precisa de dois admins.
MONEY_FOUR_EYES="false"

# Chat em tempo real (socket em /chat). Desligado por omissao: a app usa o
# REST. Ligar so quando a app passar a usar o socket.
CHAT_GATEWAY_ENABLED="false"
