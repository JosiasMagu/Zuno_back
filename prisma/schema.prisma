generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// UTILIZADORES E SESSÕES
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String         @id @default(uuid())
  phone           String         @unique
  email           String?        @unique
  name            String
  passwordHash    String
  role            UserRole       @default(CLIENT)
  isVerified      Boolean        @default(false)
  isActive        Boolean        @default(true)
  avatarUrl       String?
  bio             String?
  totalRating     Decimal?       @db.Decimal(3, 2)
  totalReviews    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sessions             AuthSession[]
  equipment            Equipment[]
  clientBookings       Booking[]      @relation("ClientBookings")
  ownerBookings        Booking[]      @relation("OwnerBookings")
  clientPayments       Payment[]      @relation("ClientPayments")
  ownerPayments        Payment[]      @relation("OwnerPayments")
  openedDisputes       Dispute[]      @relation("OpenedDisputes")
  authoredReviews      Review[]       @relation("AuthoredReviews")
  clientConversations  Conversation[] @relation("ClientConversations")
  ownerConversations   Conversation[] @relation("OwnerConversations")
  sentMessages         Message[]      @relation("SentMessages")

  @@index([role])
  @@index([isActive])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORIAS
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String      @id @default(uuid())
  name      String
  slug      String      @unique
  iconUrl   String?
  isActive  Boolean     @default(true)
  parentId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  parent    Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]  @relation("CategoryHierarchy")
  equipment Equipment[]

  @@index([parentId])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// EQUIPAMENTOS
// ─────────────────────────────────────────────────────────────────────────────

model Equipment {
  id                String             @id @default(uuid())
  ownerId           String
  title             String
  description       String
  categoryId        String
  pricePerDay       Decimal            @db.Decimal(12, 2)
  pricePerWeek      Decimal?           @db.Decimal(12, 2)
  pricePerMonth     Decimal?           @db.Decimal(12, 2)
  depositAmount     Decimal            @db.Decimal(12, 2)
  location          String
  latitude          Decimal?           @db.Decimal(10, 7)
  longitude         Decimal?           @db.Decimal(10, 7)
  deliveryIncluded  Boolean            @default(false)
  operatorAvailable Boolean            @default(false)
  isAvailable       Boolean            @default(true)
  condition         EquipmentCondition @default(GOOD)
  status            EquipmentStatus    @default(PENDING_REVIEW)
  isPremium         Boolean            @default(false)
  totalRating       Decimal?           @db.Decimal(3, 2)
  totalReviews      Int                @default(0)
  totalBookings     Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  owner         User             @relation(fields: [ownerId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  photos        EquipmentPhoto[]
  bookings      Booking[]
  conversations Conversation[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([isAvailable])
  @@index([condition])
  @@index([operatorAvailable])
}

model EquipmentPhoto {
  id          String    @id @default(uuid())
  equipmentId String
  url         String
  publicId    String?
  isPrimary   Boolean   @default(false)
  order       Int
  createdAt   DateTime  @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// RESERVAS
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id                 String        @id @default(uuid())
  clientId           String
  equipmentId        String
  ownerId            String
  startDate          DateTime
  endDate            DateTime
  totalDays          Int
  rentalAmount       Decimal       @db.Decimal(12, 2)
  depositAmount      Decimal       @db.Decimal(12, 2)
  platformFee        Decimal       @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  status             BookingStatus @default(PENDING)
  deliveryAddress    String?
  clientNote         String?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  client    User      @relation("ClientBookings", fields: [clientId], references: [id])
  owner     User      @relation("OwnerBookings", fields: [ownerId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])
  payment   Payment?
  dispute   Dispute?
  reviews   Review[]

  @@index([clientId])
  @@index([ownerId])
  @@index([equipmentId])
  @@index([status])
  @@index([startDate, endDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// PAGAMENTOS (ESCROW)
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  clientId          String
  ownerId           String
  rentalAmount      Decimal       @db.Decimal(12, 2)
  depositAmount     Decimal       @db.Decimal(12, 2)
  platformFee       Decimal       @db.Decimal(12, 2)
  totalCharged      Decimal       @db.Decimal(12, 2)
  ownerPayout       Decimal?      @db.Decimal(12, 2)
  currency          String        @default("MZN")
  method            PaymentMethod
  mpesaReference    String?
  status            PaymentStatus @default(PENDING)
  heldAt            DateTime?
  releasedAt        DateTime?
  refundedAt        DateTime?
  refundAmount      Decimal?      @db.Decimal(12, 2)
  depositReleasedAt DateTime?
  depositHeldAmount Decimal?      @db.Decimal(12, 2)
  receiptNumber     String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id])
  client   User     @relation("ClientPayments", fields: [clientId], references: [id])
  owner    User     @relation("OwnerPayments", fields: [ownerId], references: [id])
  dispute  Dispute?

  @@index([status])
  @@index([mpesaReference])
  @@index([clientId])
  @@index([ownerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DISPUTAS
// ─────────────────────────────────────────────────────────────────────────────

model Dispute {
  id             String        @id @default(uuid())
  bookingId      String        @unique
  paymentId      String        @unique
  openedBy       String
  reason         DisputeReason
  description    String
  ownerResponse  String?
  status         DisputeStatus @default(OPEN)
  resolution     String?
  refundPercent  Int?
  autoResolvedAt DateTime?
  ownerDeadline  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
  opener  User    @relation("OpenedDisputes", fields: [openedBy], references: [id])

  @@index([status])
  @@index([ownerDeadline])
  @@index([openedBy])
}

// ─────────────────────────────────────────────────────────────────────────────
// AVALIAÇÕES
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id         String           @id @default(uuid())
  bookingId  String
  authorId   String
  targetId   String
  authorRole ReviewAuthorRole
  rating     Int
  comment    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User    @relation("AuthoredReviews", fields: [authorId], references: [id])

  @@unique([bookingId, authorId])
  @@index([bookingId])
  @@index([authorId])
  @@index([targetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(uuid())
  clientId      String
  ownerId       String
  equipmentId   String
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client    User      @relation("ClientConversations", fields: [clientId], references: [id])
  owner     User      @relation("OwnerConversations", fields: [ownerId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])
  messages  Message[]

  @@unique([clientId, ownerId, equipmentId])
  @@index([clientId])
  @@index([ownerId])
  @@index([equipmentId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENT
  OWNER
  ADMIN
}

enum ReviewAuthorRole {
  CLIENT
  OWNER
}

enum EquipmentStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  DELETED
}

enum EquipmentCondition {
  NEW
  EXCELLENT
  GOOD
  USED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  MPESA
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum DisputeReason {
  NOT_DELIVERED
  DAMAGED
  DIFFERENT_FROM_AD
  LATE_DELIVERY
  OTHER
}

enum DisputeStatus {
  OPEN
  AWAITING_OWNER
  UNDER_REVIEW
  RESOLVED_CLIENT
  RESOLVED_OWNER
  RESOLVED_PARTIAL
}
