generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// UTILIZADORES E SESSÕES
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(uuid())
  phone                 String    @unique
  email                 String?   @unique
  name                  String
  passwordHash          String
  role                  UserRole  @default(CLIENT)
  isVerified            Boolean   @default(false)
  isActive              Boolean   @default(true)
  avatarUrl             String?
  bio                   String?
  pushToken             String?
  payoutMsisdn          String?
  listingsSuspendedUntil DateTime?
  /// A nota da conta como provider: o que os clientes disseram dos alugueres
  /// e dos serviços dela. Na base, as colunas mantêm o nome antigo.
  providerRating        Decimal?  @map("totalRating") @db.Decimal(3, 2)
  providerReviews       Int       @default(0) @map("totalReviews")
  /// A nota da conta como cliente: o que os providers disseram dela.
  clientRating          Decimal?  @db.Decimal(3, 2)
  clientReviews         Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions                AuthSession[]
  verificationCodes       VerificationCode[]
  verification    UserVerification?
  equipment               Equipment[]
  clientBookings          Booking[]          @relation("ClientBookings")
  ownerBookings           Booking[]          @relation("OwnerBookings")
  clientPayments          Payment[]          @relation("ClientPayments")
  ownerPayments           Payment[]          @relation("OwnerPayments")
  openedDisputes          Dispute[]          @relation("OpenedDisputes")
  authoredReviews         Review[]           @relation("AuthoredReviews")
  clientConversations     Conversation[]     @relation("ClientConversations")
  ownerConversations      Conversation[]     @relation("OwnerConversations")
  sentMessages            Message[]          @relation("SentMessages")
  providedServices        Service[]          @relation("ProvidedServices")
  clientServiceRequests   ServiceRequest[]   @relation("ClientServiceRequests")
  providedQuotes          ServiceQuote[]     @relation("ProvidedQuotes")
  clientServiceBookings   ServiceBooking[]   @relation("ClientServiceBookings")
  providerServiceBookings ServiceBooking[]   @relation("ProviderServiceBookings")
  receivedPayouts         Payout[]           @relation("PayoutRecipient")
  strikes                 ProviderStrike[]

  @@index([role])
  @@index([isActive])
}

// Falhas de login por número de telefone. Conta-se pelo número, exista ou
// não a conta, para a resposta não revelar que números estão registados.
model LoginThrottle {
  phone           String    @id
  failedAttempts  Int       @default(0)
  windowStartedAt DateTime  @default(now())
  lockedUntil     DateTime?
}

// Uma sessão por login. O refresh token é opaco e só o seu SHA-256 fica na
// base. Cada renovação troca o token: o hash anterior passa para
// previousTokenHash, para se reconhecer um token já usado.
model AuthSession {
  id                String    @id @default(uuid())
  userId            String
  refreshTokenHash  String
  previousTokenHash String?
  rotatedAt         DateTime?
  userAgent         String?
  ipAddress         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORIAS
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  iconUrl   String?
  isActive  Boolean      @default(true)
  kind      CategoryKind @default(EQUIPMENT)
  parentId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  parent    Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]  @relation("CategoryHierarchy")
  equipment Equipment[]
  services  Service[]

  @@index([parentId])
  @@index([isActive])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// EQUIPAMENTOS
// ─────────────────────────────────────────────────────────────────────────────

model Equipment {
  id                String             @id @default(uuid())
  ownerId           String
  title             String
  description       String
  categoryId        String
  pricePerDay       Decimal            @db.Decimal(12, 2)
  pricePerWeek      Decimal?           @db.Decimal(12, 2)
  pricePerMonth     Decimal?           @db.Decimal(12, 2)
  depositAmount     Decimal            @db.Decimal(12, 2)
  location          String
  latitude          Decimal?           @db.Decimal(10, 7)
  longitude         Decimal?           @db.Decimal(10, 7)
  deliveryIncluded  Boolean            @default(false)
  operatorAvailable Boolean            @default(false)
  isAvailable       Boolean            @default(true)
  quantity          Int                @default(1)
  /// Deixou de ser lida e escrita pelas reservas: as unidades livres
  /// calculam-se pelas datas (src/modules/bookings/booking-occupancy.ts).
  /// Fica até à migração que a remover.
  availableQuantity Int                @default(1)
  condition         EquipmentCondition @default(GOOD)
  status            EquipmentStatus    @default(PENDING_REVIEW)
  isPremium         Boolean            @default(false)
  totalRating       Decimal?           @db.Decimal(3, 2)
  totalReviews      Int                @default(0)
  totalBookings     Int                @default(0)
  /// Porque é que um admin rejeitou o anúncio, para o dono o corrigir.
  rejectionReason   String?
  rejectedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  owner         User             @relation(fields: [ownerId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  photos        EquipmentPhoto[]
  bookings      Booking[]
  conversations Conversation[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([isAvailable])
  @@index([condition])
  @@index([operatorAvailable])
  @@index([createdAt])
  @@index([pricePerDay])
  @@index([status, createdAt])
  @@index([status, pricePerDay])
}

model EquipmentPhoto {
  id          String   @id @default(uuid())
  equipmentId String
  url         String
  publicId    String?
  isPrimary   Boolean  @default(false)
  order       Int
  createdAt   DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// RESERVAS
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id                 String        @id @default(uuid())
  clientId           String
  equipmentId        String
  ownerId            String
  startDate          DateTime
  endDate            DateTime
  totalDays          Int
  rentalAmount       Decimal       @db.Decimal(12, 2)
  depositAmount      Decimal       @db.Decimal(12, 2)
  platformFee        Decimal       @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  status              BookingStatus @default(PENDING)
  deliveryAddress     String?
  clientNote          String?
  confirmedAt         DateTime?
  deliveryConfirmedAt DateTime?
  returnConfirmedAt   DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  /// Até quando a reserva pode ser paga. Passa a null quando o pagamento entra.
  expiresAt           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  client    User      @relation("ClientBookings", fields: [clientId], references: [id])
  owner     User      @relation("OwnerBookings", fields: [ownerId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])
  payment   Payment?
  disputes  Dispute[]
  reviews   Review[]

  @@index([clientId])
  @@index([ownerId])
  @@index([equipmentId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PAGAMENTOS (ESCROW)
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  bookingId         String?       @unique
  serviceBookingId  String?       @unique
  clientId          String
  ownerId           String
  rentalAmount      Decimal       @db.Decimal(12, 2)
  depositAmount     Decimal       @db.Decimal(12, 2)
  platformFee       Decimal       @db.Decimal(12, 2)
  totalCharged      Decimal       @db.Decimal(12, 2)
  ownerPayout       Decimal?      @db.Decimal(12, 2)
  currency          String        @default("MZN")
  method            PaymentMethod
  /// Referência da transacção M-Pesa com que o dinheiro entrou. Uma
  /// transferência só pode fechar um pagamento.
  mpesaReference    String?       @unique
  /// Número de onde veio o dinheiro, como o admin o leu no extracto.
  payerMsisdn       String?
  /// Valor que entrou de facto. O mark-held só o aceita igual ao totalCharged.
  receivedAmount    Decimal?      @db.Decimal(12, 2)
  /// O que o cliente declarou depois de pagar. Não prova nada: serve para o
  /// admin saber a que pagamento pertence uma linha do extracto, e para a
  /// reserva não expirar enquanto ele a confirma.
  declaredReference   String?
  declaredPayerMsisdn String?
  declaredAt          DateTime?
  status            PaymentStatus @default(PENDING)
  heldAt            DateTime?
  releasedAt        DateTime?
  refundedAt        DateTime?
  refundAmount      Decimal?      @db.Decimal(12, 2)
  depositStatus     DepositStatus @default(NONE)
  depositReleasedAt DateTime?
  depositHeldAmount Decimal?      @db.Decimal(12, 2)
  /// Quem deu o dinheiro como entrado: um admin, ou 'system' quando foi o
  /// fornecedor a confirmar.
  heldById          String?
  /// Quando o cliente foi avisado de que a libertação automática se aproxima.
  autoReleaseReminderAt DateTime?
  receiptNumber     String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking        Booking?        @relation(fields: [bookingId], references: [id])
  serviceBooking ServiceBooking? @relation(fields: [serviceBookingId], references: [id])
  client         User            @relation("ClientPayments", fields: [clientId], references: [id])
  owner          User            @relation("OwnerPayments", fields: [ownerId], references: [id])
  disputes       Dispute[]
  ledgerEntries  LedgerEntry[]
  payouts        Payout[]
  providerOperations ProviderOperation[]
  unallocatedFunds   UnallocatedFunds[]

  @@index([status])
  @@index([depositStatus])
  @@index([clientId])
  @@index([ownerId])
  @@index([serviceBookingId])
}

// Registo contabilístico imutável (append-only) dos movimentos do escrow.
// Invariante aplicada pelo LedgerService: SUM(OUTFLOW) nunca excede SUM(INFLOW)
// por pagamento. Nunca fazer UPDATE ou DELETE nestas linhas.
model LedgerEntry {
  id        String          @id @default(uuid())
  paymentId String
  direction LedgerDirection
  party     LedgerParty
  amount    Decimal         @db.Decimal(12, 2)
  reason    String
  actorId   String?
  createdAt DateTime        @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([createdAt])
}

// Transferência de dinheiro para fora do escrow (payout ao provider,
// reembolso/devolução de depósito ao cliente). Enquanto a execução M-Pesa
// for manual, o admin marca EXECUTED com a referência da transferência real.
model Payout {
  id             String       @id @default(uuid())
  paymentId      String
  recipientId    String
  kind           PayoutKind
  amount         Decimal      @db.Decimal(12, 2)
  msisdn         String?
  status         PayoutStatus @default(PENDING)
  /// Referência da transferência M-Pesa. Uma transferência só fecha um payout.
  mpesaReference String?      @unique
  executedById   String?
  executedAt     DateTime?
  failReason     String?
  /// Quem aprovou um payout acima do valor que sai sozinho.
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payment   Payment @relation(fields: [paymentId], references: [id])
  recipient User    @relation("PayoutRecipient", fields: [recipientId], references: [id])
  providerOperations ProviderOperation[]

  @@index([status])
  @@index([recipientId])
  @@index([paymentId])
}

// Uma cobrança, um envio ou uma devolução junto do fornecedor de pagamentos.
// `reference` é a nossa, enviada ao fornecedor: é a chave de idempotência
// dele, por isso repetir um pedido com ela nunca cobra nem envia duas vezes.
model ProviderOperation {
  id                String                  @id @default(uuid())
  provider          String
  kind              ProviderOperationKind
  reference         String                  @unique
  providerReference String?
  paymentId         String?
  payoutId          String?
  unallocatedId     String?
  amount            Decimal                 @db.Decimal(12, 2)
  msisdn            String?
  status            ProviderOperationStatus @default(REQUESTED)
  failureCode       String?
  failureReason     String?
  /// O que o fornecedor cobrou pela operação, quando o diz.
  feeAmount         Decimal?                @db.Decimal(12, 2)
  /// Quantas vezes se perguntou ao fornecedor pelo estado.
  checks            Int                     @default(0)
  lastCheckedAt     DateTime?
  confirmedAt       DateTime?
  /// A última resposta do fornecedor, sem segredos.
  response          Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  payment     Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  payout      Payout?           @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  unallocated UnallocatedFunds? @relation(fields: [unallocatedId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference], where: raw("(\"providerReference\" IS NOT NULL)"))
  @@unique([paymentId], map: "ProviderOperation_one_active_collection", where: raw("((kind = 'COLLECTION'::\"ProviderOperationKind\") AND (status = ANY (ARRAY['REQUESTED'::\"ProviderOperationStatus\", 'PENDING'::\"ProviderOperationStatus\", 'UNKNOWN'::\"ProviderOperationStatus\"])))"))
  @@unique([payoutId], map: "ProviderOperation_one_active_payout", where: raw("((kind = 'PAYOUT'::\"ProviderOperationKind\") AND (status = ANY (ARRAY['REQUESTED'::\"ProviderOperationStatus\", 'PENDING'::\"ProviderOperationStatus\", 'UNKNOWN'::\"ProviderOperationStatus\"])))"))
  @@index([status, updatedAt])
  @@index([paymentId])
  @@index([payoutId])
}

// Dinheiro que entrou na conta e não fecha nenhum pagamento: valor errado, a
// parte a mais de um pagamento, ou uma confirmação que chegou depois de a
// reserva expirar. Fica fora do escrow e tem de ser devolvido a quem pagou.
model UnallocatedFunds {
  id                String            @id @default(uuid())
  provider          String
  providerReference String
  amount            Decimal           @db.Decimal(12, 2)
  payerMsisdn       String?
  /// O pagamento a que o dinheiro parecia destinar-se, quando se sabe.
  paymentId         String?
  reason            UnallocatedReason
  status            UnallocatedStatus @default(OPEN)
  note              String?
  recordedById      String
  returnReference   String?           @unique
  returnedById      String?
  returnedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  payment    Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  operations ProviderOperation[]

  @@unique([provider, providerReference])
  @@index([status])
  @@index([paymentId])
}

// Aviso do fornecedor, guardado tal como chegou antes de ser tratado. Um
// aviso repetido não entra duas vezes.
model ProviderEvent {
  id          String    @id @default(uuid())
  provider    String
  externalId  String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@unique([provider, externalId])
  @@index([processedAt])
}

// Strike aplicado a um provider que cancela reserva confirmada (política D2).
// 3 strikes em 90 dias => suspensão de listagens.
model ProviderStrike {
  id        String   @id @default(uuid())
  userId    String
  bookingId String?
  /// Preenchido quando o strike vem de uma reserva de serviço.
  serviceBookingId String?
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// DISPUTAS
// ─────────────────────────────────────────────────────────────────────────────

// Uma reserva pode ter várias disputas ao longo da vida (do pagamento antes
// da entrega, do depósito depois dela), mas só uma aberta de cada vez. Essa
// regra está num índice único parcial sobre paymentId, na migração.
model Dispute {
  id               String        @id @default(uuid())
  bookingId        String?
  serviceBookingId String?
  paymentId        String
  openedBy         String
  type             DisputeType   @default(PAYMENT)
  reason           DisputeReason
  description      String
  evidenceUrls  String[]
  /// O que a outra parte respondeu. A coluna guarda o nome antigo.
  response         String?       @map("ownerResponse")
  /// Provas que a outra parte juntou à resposta.
  responseEvidenceUrls String[]  @default([])
  respondedAt      DateTime?
  /// Quem registou a resposta: a outra parte, ou um admin por ela.
  respondedBy      String?
  status           DisputeStatus @default(OPEN)
  resolution       String?
  refundPercent    Int?
  autoResolvedAt   DateTime?
  /// Até quando a outra parte pode responder. A coluna guarda o nome antigo.
  responseDeadline DateTime?     @map("ownerDeadline")
  /// Quando a disputa fechou: resolvida pelo admin ou retirada.
  closedAt         DateTime?
  closedBy         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking        Booking?        @relation(fields: [bookingId], references: [id])
  serviceBooking ServiceBooking? @relation(fields: [serviceBookingId], references: [id])
  payment        Payment         @relation(fields: [paymentId], references: [id])
  opener         User            @relation("OpenedDisputes", fields: [openedBy], references: [id])

  @@index([status])
  @@index([responseDeadline])
  @@index([openedBy])
  @@index([serviceBookingId])
  @@index([bookingId])
  @@index([paymentId])
  // Uma disputa aberta de cada vez por pagamento. Criado na migração
  // disputes_due_process. Declarado aqui para um migrate dev não o apagar.
  @@unique([paymentId], map: "Dispute_one_open_per_payment", where: raw("(status = ANY (ARRAY['OPEN'::\"DisputeStatus\", 'AWAITING_OWNER'::\"DisputeStatus\", 'UNDER_REVIEW'::\"DisputeStatus\"]))"))
}

// ─────────────────────────────────────────────────────────────────────────────
// AVALIAÇÕES
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id               String           @id @default(uuid())
  bookingId        String?
  serviceBookingId String?
  authorId         String
  targetId         String
  authorRole       ReviewAuthorRole
  rating           Int
  comment          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceBooking ServiceBooking? @relation(fields: [serviceBookingId], references: [id], onDelete: Cascade)
  author         User            @relation("AuthoredReviews", fields: [authorId], references: [id])

  @@unique([bookingId, authorId], where: raw("(\"bookingId\" IS NOT NULL)"))
  @@unique([serviceBookingId, authorId], where: raw("(\"serviceBookingId\" IS NOT NULL)"))
  @@index([bookingId])
  @@index([serviceBookingId])
  @@index([authorId])
  @@index([targetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(uuid())
  clientId      String
  ownerId       String
  equipmentId   String?
  serviceId     String?
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client    User       @relation("ClientConversations", fields: [clientId], references: [id])
  owner     User       @relation("OwnerConversations", fields: [ownerId], references: [id])
  equipment Equipment? @relation(fields: [equipmentId], references: [id])
  service   Service?   @relation(fields: [serviceId], references: [id])
  messages  Message[]

  @@unique([clientId, ownerId, equipmentId], where: raw("(\"equipmentId\" IS NOT NULL)"))
  @@unique([clientId, ownerId, serviceId], where: raw("(\"serviceId\" IS NOT NULL)"))
  @@index([clientId])
  @@index([ownerId])
  @@index([equipmentId])
  @@index([serviceId])
  @@index([clientId, createdAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([conversationId, createdAt])
  @@index([conversationId], map: "Message_unread_idx", where: raw("(\"isRead\" = false)"))
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVIÇOS (PRESTAÇÃO DE SERVIÇOS)
// ─────────────────────────────────────────────────────────────────────────────

model Service {
  id              String             @id @default(uuid())
  providerId      String
  title           String
  description     String
  categoryId      String
  basePrice       Decimal            @db.Decimal(12, 2)
  pricingType     ServicePricingType @default(FIXED)
  estimatedHours  Int?
  location        String
  latitude        Decimal?           @db.Decimal(10, 7)
  longitude       Decimal?           @db.Decimal(10, 7)
  acceptsUrgent   Boolean            @default(false)
  urgentSurcharge Decimal?           @db.Decimal(5, 2)
  status          ServiceStatus      @default(PENDING_REVIEW)
  isActive        Boolean            @default(true)
  totalRating     Decimal?           @db.Decimal(3, 2)
  totalReviews    Int                @default(0)
  totalCompleted  Int                @default(0)
  /// Porque é que um admin rejeitou o anúncio, para o provider o corrigir.
  rejectionReason String?
  rejectedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  provider      User             @relation("ProvidedServices", fields: [providerId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  photos        ServicePhoto[]
  requests      ServiceRequest[]
  bookings      ServiceBooking[]
  conversations Conversation[]

  @@index([providerId])
  @@index([categoryId])
  @@index([status])
  @@index([isActive])
  @@index([status, isActive, createdAt])
}

model ServicePhoto {
  id        String   @id @default(uuid())
  serviceId String
  url       String
  publicId  String?
  isPrimary Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceRequest {
  id            String               @id @default(uuid())
  clientId      String
  serviceId     String
  description   String
  preferredDate DateTime?
  isUrgent      Boolean              @default(false)
  address       String
  latitude      Decimal?             @db.Decimal(10, 7)
  longitude     Decimal?             @db.Decimal(10, 7)
  status        ServiceRequestStatus @default(OPEN)
  expiresAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  client  User            @relation("ClientServiceRequests", fields: [clientId], references: [id])
  service Service         @relation(fields: [serviceId], references: [id])
  quotes  ServiceQuote[]
  booking ServiceBooking?

  @@index([clientId])
  @@index([serviceId])
  @@index([status])
  @@index([expiresAt])
}

model ServiceQuote {
  id              String             @id @default(uuid())
  requestId       String
  providerId      String
  amount          Decimal            @db.Decimal(12, 2)
  urgentSurcharge Decimal?           @db.Decimal(12, 2)
  totalAmount     Decimal            @db.Decimal(12, 2)
  estimatedDays   Int
  message         String?
  status          ServiceQuoteStatus @default(PENDING)
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider User            @relation("ProvidedQuotes", fields: [providerId], references: [id])
  booking  ServiceBooking?

  @@unique([requestId, providerId])
  @@index([requestId])
  @@index([providerId])
  @@index([status])
}

model ServiceBooking {
  id                 String               @id @default(uuid())
  clientId           String
  providerId         String
  serviceId          String
  requestId          String               @unique
  quoteId            String               @unique
  scheduledFor       DateTime?
  isUrgent           Boolean              @default(false)
  serviceAmount      Decimal              @db.Decimal(12, 2)
  platformFee        Decimal              @db.Decimal(12, 2)
  totalAmount        Decimal              @db.Decimal(12, 2)
  status             ServiceBookingStatus @default(PENDING)
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  /// Até quando a reserva pode ser paga. Passa a null quando o pagamento entra.
  expiresAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  client   User           @relation("ClientServiceBookings", fields: [clientId], references: [id])
  provider User           @relation("ProviderServiceBookings", fields: [providerId], references: [id])
  service  Service        @relation(fields: [serviceId], references: [id])
  request  ServiceRequest @relation(fields: [requestId], references: [id])
  quote    ServiceQuote   @relation(fields: [quoteId], references: [id])
  payment  Payment?
  disputes Dispute[]
  reviews  Review[]

  @@index([clientId])
  @@index([providerId])
  @@index([serviceId])
  @@index([status])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// VERIFICAÇÃO
// ─────────────────────────────────────────────────────────────────────────────

model VerificationCode {
  id        String              @id @default(uuid())
  userId    String
  purpose   VerificationPurpose
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  actorId    String
  targetType String
  targetId   String
  amount     Decimal?    @db.Decimal(12, 2)
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String
  userId         String
  endpoint       String
  requestHash    String
  responseStatus Int      @default(0)
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([key, userId, endpoint])
  @@index([expiresAt])
}

model UserVerification {
  id               String             @id @default(uuid())
  userId           String             @unique
  status           VerificationStatus @default(PENDING)
  documentType     DocumentType
  // Identificadores das imagens no armazenamento privado. O endereço gera-se
  // a pedido e expira.
  documentFrontId  String?
  documentBackId   String?
  selfieId         String?
  // Do tempo em que a submissão trazia endereços. Já não se escrevem.
  documentFrontUrl String?
  documentBackUrl  String?
  selfieUrl        String?
  submittedAt      DateTime           @default(now())
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([submittedAt])
}
