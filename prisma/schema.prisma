generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// UTILIZADORES E SESSÕES
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String         @id @default(uuid())
  phone           String         @unique
  email           String?        @unique
  name            String
  passwordHash    String
  role            UserRole       @default(CLIENT)
  isVerified      Boolean        @default(false)
  isActive        Boolean        @default(true)
  avatarUrl       String?
  bio             String?
  pushToken       String?
  totalRating     Decimal?       @db.Decimal(3, 2)
  totalReviews    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sessions                AuthSession[]
  verificationCodes       VerificationCode[]
  equipment               Equipment[]
  clientBookings          Booking[]          @relation("ClientBookings")
  ownerBookings           Booking[]          @relation("OwnerBookings")
  clientPayments          Payment[]          @relation("ClientPayments")
  ownerPayments           Payment[]          @relation("OwnerPayments")
  openedDisputes          Dispute[]          @relation("OpenedDisputes")
  authoredReviews         Review[]           @relation("AuthoredReviews")
  clientConversations     Conversation[]     @relation("ClientConversations")
  ownerConversations      Conversation[]     @relation("OwnerConversations")
  sentMessages            Message[]          @relation("SentMessages")
  providedServices        Service[]          @relation("ProvidedServices")
  clientServiceRequests   ServiceRequest[]   @relation("ClientServiceRequests")
  providedQuotes          ServiceQuote[]     @relation("ProvidedQuotes")
  clientServiceBookings   ServiceBooking[]   @relation("ClientServiceBookings")
  providerServiceBookings ServiceBooking[]   @relation("ProviderServiceBookings")

  @@index([role])
  @@index([isActive])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORIAS
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  iconUrl   String?
  isActive  Boolean      @default(true)
  kind      CategoryKind @default(EQUIPMENT)
  parentId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  parent    Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]  @relation("CategoryHierarchy")
  equipment Equipment[]
  services  Service[]

  @@index([parentId])
  @@index([isActive])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// EQUIPAMENTOS
// ─────────────────────────────────────────────────────────────────────────────

model Equipment {
  id                String             @id @default(uuid())
  ownerId           String
  title             String
  description       String
  categoryId        String
  pricePerDay       Decimal            @db.Decimal(12, 2)
  pricePerWeek      Decimal?           @db.Decimal(12, 2)
  pricePerMonth     Decimal?           @db.Decimal(12, 2)
  depositAmount     Decimal            @db.Decimal(12, 2)
  location          String
  latitude          Decimal?           @db.Decimal(10, 7)
  longitude         Decimal?           @db.Decimal(10, 7)
  deliveryIncluded  Boolean            @default(false)
  operatorAvailable Boolean            @default(false)
  isAvailable       Boolean            @default(true)
  condition         EquipmentCondition @default(GOOD)
  status            EquipmentStatus    @default(PENDING_REVIEW)
  isPremium         Boolean            @default(false)
  totalRating       Decimal?           @db.Decimal(3, 2)
  totalReviews      Int                @default(0)
  totalBookings     Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  owner         User             @relation(fields: [ownerId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  photos        EquipmentPhoto[]
  bookings      Booking[]
  conversations Conversation[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([isAvailable])
  @@index([condition])
  @@index([operatorAvailable])
  // Suportam ORDER BY no catalogo (sortBy=newest/lowest_price/highest_price)
  // e filtros de intervalo de preco. Sem isto, ORDER BY faz full scan.
  @@index([createdAt])
  @@index([pricePerDay])
}

model EquipmentPhoto {
  id          String    @id @default(uuid())
  equipmentId String
  url         String
  publicId    String?
  isPrimary   Boolean   @default(false)
  order       Int
  createdAt   DateTime  @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// RESERVAS
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id                 String        @id @default(uuid())
  clientId           String
  equipmentId        String
  ownerId            String
  startDate          DateTime
  endDate            DateTime
  totalDays          Int
  rentalAmount       Decimal       @db.Decimal(12, 2)
  depositAmount      Decimal       @db.Decimal(12, 2)
  platformFee        Decimal       @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  status             BookingStatus @default(PENDING)
  deliveryAddress    String?
  clientNote         String?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  client    User      @relation("ClientBookings", fields: [clientId], references: [id])
  owner     User      @relation("OwnerBookings", fields: [ownerId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])
  payment   Payment?
  dispute   Dispute?
  reviews   Review[]

  @@index([clientId])
  @@index([ownerId])
  @@index([equipmentId])
  @@index([status])
  @@index([startDate, endDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// PAGAMENTOS (ESCROW)
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  bookingId         String?       @unique
  serviceBookingId  String?       @unique
  clientId          String
  ownerId           String
  rentalAmount      Decimal       @db.Decimal(12, 2)
  depositAmount     Decimal       @db.Decimal(12, 2)
  platformFee       Decimal       @db.Decimal(12, 2)
  totalCharged      Decimal       @db.Decimal(12, 2)
  ownerPayout       Decimal?      @db.Decimal(12, 2)
  currency          String        @default("MZN")
  method            PaymentMethod
  mpesaReference    String?
  status            PaymentStatus @default(PENDING)
  heldAt            DateTime?
  releasedAt        DateTime?
  refundedAt        DateTime?
  refundAmount      Decimal?      @db.Decimal(12, 2)
  depositReleasedAt DateTime?
  depositHeldAmount Decimal?      @db.Decimal(12, 2)
  receiptNumber     String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking        Booking?        @relation(fields: [bookingId], references: [id])
  serviceBooking ServiceBooking? @relation(fields: [serviceBookingId], references: [id])
  client         User            @relation("ClientPayments", fields: [clientId], references: [id])
  owner          User            @relation("OwnerPayments", fields: [ownerId], references: [id])
  dispute        Dispute?

  @@index([status])
  @@index([mpesaReference])
  @@index([clientId])
  @@index([ownerId])
  @@index([serviceBookingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DISPUTAS
// ─────────────────────────────────────────────────────────────────────────────

model Dispute {
  id               String        @id @default(uuid())
  bookingId        String?       @unique
  serviceBookingId String?       @unique
  paymentId        String        @unique
  openedBy         String
  reason           DisputeReason
  description      String
  ownerResponse    String?
  status           DisputeStatus @default(OPEN)
  resolution       String?
  refundPercent    Int?
  autoResolvedAt   DateTime?
  ownerDeadline    DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking        Booking?        @relation(fields: [bookingId], references: [id])
  serviceBooking ServiceBooking? @relation(fields: [serviceBookingId], references: [id])
  payment        Payment         @relation(fields: [paymentId], references: [id])
  opener         User            @relation("OpenedDisputes", fields: [openedBy], references: [id])

  @@index([status])
  @@index([ownerDeadline])
  @@index([openedBy])
  @@index([serviceBookingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AVALIAÇÕES
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id               String           @id @default(uuid())
  bookingId        String?
  serviceBookingId String?
  authorId         String
  targetId         String
  authorRole       ReviewAuthorRole
  rating           Int
  comment          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceBooking ServiceBooking? @relation(fields: [serviceBookingId], references: [id], onDelete: Cascade)
  author         User            @relation("AuthoredReviews", fields: [authorId], references: [id])

  @@index([bookingId])
  @@index([serviceBookingId])
  @@index([authorId])
  @@index([targetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(uuid())
  clientId      String
  ownerId       String
  equipmentId   String?
  serviceId     String?
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client    User       @relation("ClientConversations", fields: [clientId], references: [id])
  owner     User       @relation("OwnerConversations", fields: [ownerId], references: [id])
  equipment Equipment? @relation(fields: [equipmentId], references: [id])
  service   Service?   @relation(fields: [serviceId], references: [id])
  messages  Message[]

  @@index([clientId])
  @@index([ownerId])
  @@index([equipmentId])
  @@index([serviceId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVIÇOS (PRESTAÇÃO DE SERVIÇOS)
// ─────────────────────────────────────────────────────────────────────────────

model Service {
  id              String             @id @default(uuid())
  providerId      String
  title           String
  description     String
  categoryId      String
  basePrice       Decimal            @db.Decimal(12, 2)
  pricingType     ServicePricingType @default(FIXED)
  estimatedHours  Int?
  location        String
  latitude        Decimal?           @db.Decimal(10, 7)
  longitude       Decimal?           @db.Decimal(10, 7)
  acceptsUrgent   Boolean            @default(false)
  urgentSurcharge Decimal?           @db.Decimal(5, 2)
  status          ServiceStatus      @default(PENDING_REVIEW)
  isActive        Boolean            @default(true)
  totalRating     Decimal?           @db.Decimal(3, 2)
  totalReviews    Int                @default(0)
  totalCompleted  Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  provider      User             @relation("ProvidedServices", fields: [providerId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  photos        ServicePhoto[]
  requests      ServiceRequest[]
  bookings      ServiceBooking[]
  conversations Conversation[]

  @@index([providerId])
  @@index([categoryId])
  @@index([status])
  @@index([isActive])
}

model ServicePhoto {
  id        String   @id @default(uuid())
  serviceId String
  url       String
  publicId  String?
  isPrimary Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceRequest {
  id            String               @id @default(uuid())
  clientId      String
  serviceId     String
  description   String
  preferredDate DateTime?
  isUrgent      Boolean              @default(false)
  address       String
  latitude      Decimal?             @db.Decimal(10, 7)
  longitude     Decimal?             @db.Decimal(10, 7)
  status        ServiceRequestStatus @default(OPEN)
  expiresAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  client  User            @relation("ClientServiceRequests", fields: [clientId], references: [id])
  service Service         @relation(fields: [serviceId], references: [id])
  quotes  ServiceQuote[]
  booking ServiceBooking?

  @@index([clientId])
  @@index([serviceId])
  @@index([status])
  @@index([expiresAt])
}

model ServiceQuote {
  id              String             @id @default(uuid())
  requestId       String
  providerId      String
  amount          Decimal            @db.Decimal(12, 2)
  urgentSurcharge Decimal?           @db.Decimal(12, 2)
  totalAmount     Decimal            @db.Decimal(12, 2)
  estimatedDays   Int
  message         String?
  status          ServiceQuoteStatus @default(PENDING)
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider User            @relation("ProvidedQuotes", fields: [providerId], references: [id])
  booking  ServiceBooking?

  @@unique([requestId, providerId])
  @@index([requestId])
  @@index([providerId])
  @@index([status])
}

model ServiceBooking {
  id                 String               @id @default(uuid())
  clientId           String
  providerId         String
  serviceId          String
  requestId          String               @unique
  quoteId            String               @unique
  scheduledFor       DateTime?
  isUrgent           Boolean              @default(false)
  serviceAmount      Decimal              @db.Decimal(12, 2)
  platformFee        Decimal              @db.Decimal(12, 2)
  totalAmount        Decimal              @db.Decimal(12, 2)
  status             ServiceBookingStatus @default(PENDING)
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  client   User           @relation("ClientServiceBookings", fields: [clientId], references: [id])
  provider User           @relation("ProviderServiceBookings", fields: [providerId], references: [id])
  service  Service        @relation(fields: [serviceId], references: [id])
  request  ServiceRequest @relation(fields: [requestId], references: [id])
  quote    ServiceQuote   @relation(fields: [quoteId], references: [id])
  payment  Payment?
  dispute  Dispute?
  reviews  Review[]

  @@index([clientId])
  @@index([providerId])
  @@index([serviceId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum ReviewAuthorRole {
  CLIENT
  PROVIDER
}

enum EquipmentStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  DELETED
}

enum EquipmentCondition {
  NEW
  EXCELLENT
  GOOD
  USED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  MPESA
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum DisputeReason {
  NOT_DELIVERED
  DAMAGED
  DIFFERENT_FROM_AD
  LATE_DELIVERY
  SERVICE_NOT_PERFORMED
  SERVICE_QUALITY_POOR
  OTHER
}

enum DisputeStatus {
  OPEN
  AWAITING_OWNER
  UNDER_REVIEW
  RESOLVED_CLIENT
  RESOLVED_OWNER
  RESOLVED_PARTIAL
}

enum AuditAction {
  PAYMENT_INITIATED
  PAYMENT_MARKED_HELD
  PAYMENT_RELEASED
  PAYMENT_REFUNDED
  PAYMENT_PARTIALLY_REFUNDED
  DISPUTE_OPENED
  DISPUTE_RESPONDED
  DISPUTE_RESOLVED_CLIENT
  DISPUTE_RESOLVED_OWNER
  DISPUTE_RESOLVED_PARTIAL
  SERVICE_REQUEST_CREATED
  SERVICE_QUOTE_SUBMITTED
  SERVICE_QUOTE_ACCEPTED
  SERVICE_BOOKING_STARTED
  SERVICE_BOOKING_COMPLETED
  SERVICE_BOOKING_CANCELLED
}

enum CategoryKind {
  EQUIPMENT
  SERVICE
  BOTH
}

enum ServicePricingType {
  FIXED
  HOURLY
  QUOTE
}

enum ServiceStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  DELETED
}

enum ServiceRequestStatus {
  OPEN
  QUOTED
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum ServiceQuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ServiceBookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum VerificationPurpose {
  PHONE_VERIFICATION
  PASSWORD_RESET
}

model VerificationCode {
  id        String              @id @default(uuid())
  userId    String
  purpose   VerificationPurpose
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
}

model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  actorId    String
  targetType String
  targetId   String
  amount     Decimal?    @db.Decimal(12, 2)
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}
